# --- Flutter / Dart ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
flutter_*.log
# pub get 生成；内含本机绝对路径
.flutter-plugins-dependencies
# 本机 PUB_HOSTED_URL 是 pub.flutter-io.cn，写进 lock 会把 CI 也拽到该镜像
pubspec.lock
# 鸿蒙构建时由 tool/build_hap.sh 从 tool/pubspec_overrides.ohos.yaml 复制出来，
# 只在本机存在；提交会让标准 Flutter（含 CI）解析到 TargetPlatform.ohos 而编译失败
pubspec_overrides.yaml
*.iml
*.ipr
*.iws

# --- Android ---
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/**/*.keystore
android/**/*.jks
android/captures/

# --- iOS ---
ios/Flutter/.last_build_id
ios/Pods/
ios/.symlinks/
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Flutter/ephemeral/

# --- IDE ---
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

